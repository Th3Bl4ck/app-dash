{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, immutable"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "58 5 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "13 13 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "28 20 * * 1-5"
    },
    {
      "path": "/api/cron",
      "schedule": "58 19 * * 0"
    }
  ]
}
